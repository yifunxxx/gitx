{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitx",
  "version": "0.1.19",
  "identifier": "app.gitx.desktop",
  "build": {
    "beforeDevCommand": "pnpm helper:build && pnpm --filter @gitx/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm helper:build --release && pnpm --filter @gitx/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "gitx",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/gitx-helper"]
  },
  "plugins": {}
}
